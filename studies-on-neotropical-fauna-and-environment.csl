<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="en-GB">
  <info>
    <title>Studies on Neotropical Fauna and Environment</title>
    <title-short>SNFE</title-short>
    <id>http://www.zotero.org/styles/studies-on-neotropical-fauna-and-environment</id>
    <link href="http://www.zotero.org/styles/studies-on-neotropical-fauna-and-environment" rel="self"/>
    <link href="https://www.tandfonline.com/journals/nnfe20" rel="documentation"/>
    <author>
      <name>Ed</name>
      <uri>https://github.com/Edbbioeco</uri>
    </author>
    <category citation-format="author-date"/>
    <category field="zoology"/>
    <issn>0165-0521</issn>
    <eissn>1744-5140</eissn>
    <summary>Estilo autor-ano da Studies on Neotropical Fauna and Environment (Taylor &amp; Francis), baseado em artigo publicado em 2026.</summary>
    <updated>2026-10-04T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!-- Autores no texto: Sobrenome e Sobrenome / Sobrenome et al. (3+) -->
  <macro name="author-short">
    <choose>
      <if variable="author">
        <names variable="author">
          <name form="short" and="text" delimiter=", " et-al-min="3" et-al-use-first="1" delimiter-precedes-et-al="never"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name form="short" and="text" delimiter=", " et-al-min="3" et-al-use-first="1" delimiter-precedes-et-al="never"/>
        </names>
      </else-if>
      <else>
        <text variable="title" form="short"/>
      </else>
    </choose>
  </macro>

  <!-- Autores na lista: Sobrenome INICIAIS, Sobrenome INICIAIS. -->
  <macro name="author-bib">
    <choose>
      <if variable="author">
        <names variable="author">
          <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/>
          <label form="long" prefix=", "/>
        </names>
      </else-if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>

  <macro name="editor-container">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", "/>
      <label form="long" prefix=", "/>
    </names>
  </macro>

  <macro name="year">
    <choose>
      <if variable="issued">
        <group>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </group>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="doi-url">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <macro name="accessed">
    <choose>
      <if variable="accessed">
        <group prefix="[accessed " suffix="].">
          <date variable="accessed">
            <date-part name="year"/>
            <date-part name="month" form="short" prefix=" " strip-periods="true"/>
            <date-part name="day" prefix=" "/>
          </date>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else-if variable="edition">
        <text variable="edition" suffix="."/>
      </else-if>
    </choose>
  </macro>

  <macro name="version">
    <text variable="version" prefix="Version " suffix="."/>
  </macro>

  <macro name="pages-label">
    <group delimiter=" " suffix=".">
      <text value="p"/>
      <text variable="page"/>
    </group>
  </macro>

  <!-- Artigo de periódico: Título. Periódico abreviado. Vol(Núm):páginas. DOI -->
  <macro name="journal-entry">
    <group delimiter=" ">
      <text variable="title" suffix="."/>
      <text variable="container-title" form="short" suffix="."/>
      <group suffix=".">
        <text variable="volume"/>
        <text variable="issue" prefix="(" suffix=")"/>
        <choose>
          <if variable="page">
            <text variable="page" prefix=":"/>
          </if>
          <else>
            <text variable="number" prefix=":"/>
          </else>
        </choose>
      </group>
      <text macro="doi-url"/>
    </group>
  </macro>

  <!-- Capítulo / trabalho em evento: Título. In: Editores, editors. Livro. Editora. p x–y. DOI -->
  <macro name="chapter-entry">
    <group delimiter=" ">
      <text variable="title" suffix="."/>
      <group delimiter=" ">
        <text term="in" text-case="capitalize-first" suffix=":"/>
        <text macro="editor-container" suffix="."/>
        <text variable="container-title" suffix="."/>
      </group>
      <text macro="edition"/>
      <text variable="publisher" suffix="."/>
      <choose>
        <if variable="page">
          <text macro="pages-label"/>
        </if>
      </choose>
      <text macro="doi-url"/>
    </group>
  </macro>

  <!-- Livro: Título. Edição. Editora. DOI -->
  <macro name="book-entry">
    <group delimiter=" ">
      <text variable="title" suffix="."/>
      <text macro="edition"/>
      <text variable="publisher" suffix="."/>
      <text macro="doi-url"/>
    </group>
  </macro>

  <!-- Tese/dissertação -->
  <macro name="thesis-entry">
    <group delimiter=" ">
      <group delimiter=" " suffix=".">
        <text variable="title"/>
        <text variable="genre" prefix="[" suffix="]"/>
      </group>
      <text variable="publisher" suffix="."/>
      <text macro="doi-url"/>
    </group>
  </macro>

  <!-- Demais tipos (site, banco de dados, software, relatório, lei...) -->
  <macro name="generic-entry">
    <group delimiter=" ">
      <text variable="title" suffix="."/>
      <text variable="container-title" suffix="."/>
      <text macro="version"/>
      <text variable="publisher" suffix="."/>
      <text macro="accessed"/>
      <text macro="doi-url"/>
    </group>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year">
    <sort>
      <key variable="issued"/>
      <key macro="author-bib" names-min="100" names-use-first="100"/>
      <key variable="title"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author-short"/>
        <text macro="year"/>
        <group delimiter=" " prefix=", ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" et-al-min="11" et-al-use-first="10">
    <sort>
      <key macro="author-bib"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author-bib" suffix="."/>
        <text macro="year" suffix="."/>
        <choose>
          <if type="article-journal article-magazine article-newspaper" match="any">
            <text macro="journal-entry"/>
          </if>
          <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
            <text macro="chapter-entry"/>
          </else-if>
          <else-if type="book" match="any">
            <text macro="book-entry"/>
          </else-if>
          <else-if type="thesis" match="any">
            <text macro="thesis-entry"/>
          </else-if>
          <else>
            <text macro="generic-entry"/>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
